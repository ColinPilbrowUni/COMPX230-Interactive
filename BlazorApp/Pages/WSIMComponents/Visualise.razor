@using RexSimulator.Hardware
@using RexSimulator.Hardware.Wramp
@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime

<div class="accordion my-2">
    <div class="accordion-item">
        <h2 class="accordion-header">
            <button class="accordion-button collapsed text-end" type="button" data-bs-toggle="collapse" data-bs-target="#visualiser" aria-expanded="false" aria-controls="visualiser">
                Visualiser
            </button>
        </h2>
        <div id="visualiser" class="accordion-collapse collapse">
            <div class="accordion-body">
                <table class="table-sm mx-auto w-50">
                    @if (CodeStatements?.Count() > Board.CPU.PC && (Regex.IsMatch(ir.ToString(), shiftRegex) || Regex.IsMatch(ir.ToString(), arithmeticRegex)))
                    {
                        <thead>
                            <tr>
                                <th class="text-center" colspan="4">@CodeStatements?[Board.CPU.PC]</th>
                            </tr>
                        </thead>

                        <tbody class="table-group-divider" @key="ir.ToString()">
                                @* Rs *@
                                <tr>
                                    <td class="format"><i class="bi bi-arrow-clockwise" @onclick='() => changeFormat("visualiseSource")'></i></td>
                                    <td>$@ir.Rs:</td>
                                    <td></td>
                                    <td class="text-end" id="visualiseSource"></td>
                                </tr>

                                @* i / Rt *@
                                <tr>
                                    @if (ir.OpCode == IR.Opcode.arith_i)
                                    {
                                        <td class="format"><i class="bi bi-arrow-clockwise" @onclick='() => changeFormat("visualiseImmed")'></i></td>
                                        <td>i:</td>
                                        <td class="text-center" id="visualiseSign"></td>
                                        <td class="text-end" id="visualiseImmed"></td>
                                    }
                                    else
                                    {
                                        <td class="format"><i class="bi bi-arrow-clockwise" @onclick='() => changeFormat("visualiseSourceTwo")'></i></td>
                                        <td>$@ir.Rt:</td>
                                        <td class="text-center" id="visualiseSign"></td>
                                        <td class="text-end" id="visualiseSourceTwo"></td>
                                    }
                                </tr>

                                @* Rd *@
                                <tr class="border-top">
                                    <td class="format"><i class="bi bi-arrow-clockwise" @onclick='() => changeFormat("visualiseDest")'></i></td>
                                    <td>$@ir.Rd:</td>
                                    <td></td>
                                    <td class="text-end" id="visualiseDest"></td>
                                </tr>
                        </tbody>
                    }
                    else
                    {
                        <thead class="text-center">
                            <tr><th>The current instruction cannot be visualised</th></tr>
                        </thead>
                        <tbody class="table-group-divider text-center">
                            <tr><td>When an arithmetic or shifting instruction is about to execute, this component will display the instruction, the registers involved and their contents, and the result of the operation in the destination register!</td></tr>
                        </tbody>
                    }
                </table>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter]
    required public IR ir { get; set; }

    [Parameter]
    required public string[] CodeStatements { get; set; }

    [Parameter]
    required public RexBoard Board { get; set; }

    public string shiftRegex = @"sl(li||l)|sr(l|li|a|ai)";
    public string arithmeticRegex = @"(add|sub|mult|div|rem)u?i?|lhi";

    private bool needVisualiseUpdate = false;

    void changeFormat(string id)
    {
        JSRuntime.InvokeVoidAsync("changeFormat", id, ir.ToString());
    }

    private static string FormatBinary32(uint value)
    {
        return "0b" + Convert.ToString(value, 2).PadLeft(32, '0');
    }

    private static string FormatBinary16(uint value)
    {
        return "0b" + Convert.ToString(value, 2).PadLeft(16, '0');
    }

    private uint GetArithmeticResult()
    {
        uint left = Board.CPU.mGpRegisters[ir.Rs];

        if (ir.OpCode == IR.Opcode.arith_i)
        {
            uint rightRaw = ir.Immed16;
            int signedLeft = unchecked((int)left);
            int signedRight = unchecked((short)rightRaw);

            return ir.Func switch
            {
                IR.Function.add => unchecked((uint)(signedLeft + signedRight)),
                IR.Function.addu => unchecked(left + rightRaw),
                IR.Function.sub => unchecked((uint)(signedLeft - signedRight)),
                IR.Function.subu => unchecked(left - rightRaw),
                IR.Function.mult => unchecked((uint)(signedLeft * signedRight)),
                IR.Function.multu => unchecked(left * rightRaw),
                IR.Function.div => signedRight == 0 ? 0u : unchecked((uint)(signedLeft / signedRight)),
                IR.Function.divu => rightRaw == 0 ? 0u : unchecked(left / rightRaw),
                IR.Function.rem => signedRight == 0 ? 0u : unchecked((uint)(signedLeft % signedRight)),
                IR.Function.remu => rightRaw == 0 ? 0u : unchecked(left % rightRaw),
                IR.Function.lhi => rightRaw << 16,
                _ => throw new InvalidOperationException($"Unsupported arithmetic function: {ir.Func}")
            };
        }

        uint right = Board.CPU.mGpRegisters[ir.Rt];
        int signedLeftRegister = unchecked((int)left);
        int signedRightRegister = unchecked((int)right);

        return ir.Func switch
        {
            IR.Function.add => unchecked((uint)(signedLeftRegister + signedRightRegister)),
            IR.Function.addu => unchecked(left + right),
            IR.Function.sub => unchecked((uint)(signedLeftRegister - signedRightRegister)),
            IR.Function.subu => unchecked(left - right),
            IR.Function.mult => unchecked((uint)(signedLeftRegister * signedRightRegister)),
            IR.Function.multu => unchecked(left * right),
            IR.Function.div => signedRightRegister == 0 ? 0u : unchecked((uint)(signedLeftRegister / signedRightRegister)),
            IR.Function.divu => right == 0 ? 0u : unchecked(left / right),
            IR.Function.rem => signedRightRegister == 0 ? 0u : unchecked((uint)(signedLeftRegister % signedRightRegister)),
            IR.Function.remu => right == 0 ? 0u : unchecked(left % right),
            IR.Function.lhi => right << 16,
            _ => throw new InvalidOperationException($"Unsupported arithmetic function: {ir.Func}")
        };
    }

    private uint GetShiftResult()
    {
        uint value = Board.CPU.mGpRegisters[ir.Rs];
        int shiftAmount = ir.OpCode == IR.Opcode.arith_i
            ? (int)ir.Immed16
            : (int)Board.CPU.mGpRegisters[ir.Rt];

        return ir.Func switch
        {
            IR.Function.sll => value << shiftAmount,
            IR.Function.srl => value >> shiftAmount,
            IR.Function.sra => unchecked((uint)((int)value >> shiftAmount)),
            _ => throw new InvalidOperationException($"Unsupported shift function: {ir.Func}")
        };
    }

    protected override Task OnParametersSetAsync()
    {
        needVisualiseUpdate = true;
        return base.OnParametersSetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!needVisualiseUpdate) return;
        needVisualiseUpdate = false;

        @* Sign *@
        await JSRuntime.InvokeVoidAsync("updateSign", ir.ToString());

        @* Rs *@
        await JSRuntime.InvokeVoidAsync("updateVisualiser", "visualiseSource", FormatBinary32(Board.CPU.mGpRegisters[ir.Rs]));

        @* i / Rt *@
        if (ir.OpCode == IR.Opcode.arith_i)
        {
            await JSRuntime.InvokeVoidAsync("updateVisualiser", "visualiseImmed", Regex.IsMatch(ir.ToString(), arithmeticRegex) ? FormatBinary16(ir.Immed16) : ir.Immed16);
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("updateVisualiser", "visualiseSourceTwo", FormatBinary32(Board.CPU.mGpRegisters[ir.Rt]));
        }

        @* Rd *@
        if (Regex.IsMatch(ir.ToString(), arithmeticRegex))
        {
            await JSRuntime.InvokeVoidAsync("updateVisualiser", "visualiseDest", FormatBinary32(GetArithmeticResult()));
        }
        else
        {
            await JSRuntime.InvokeVoidAsync("updateVisualiser", "visualiseDest", FormatBinary32(GetShiftResult()));
        }
    }
}