    void updateSSDs()
    {
        uint[] SSD_DECODE = { 0x3F, 0x06, 0x5B, 0x4F, 0x66, 0x6D, 0x7D, 0x7, 0x7F, 0x6F, 0x77, 0x7C, 0x39, 0x5E, 0x79, 0x71 };
        uint[] values = {board.Parallel.LeftLeftSSD, board.Parallel.LeftRightSSD, board.Parallel.LeftSSD, board.Parallel.RightSSD};
        string[] IDs = {"sevenSegOne", "sevenSegTwo", "sevenSegThree", "sevenSegFour"};
        //If Hex-decode is enabled
        if ((board.Parallel.Control & 1) == 1)
        {
            for (int i = 0; i < values.Length; i++)
            {
                uint value = values[i] & 0xF;
                uint segments = SSD_DECODE[value];
                for (int i2 = 0; i2 < 8; i2++)
                {
                    uint bit = segments & 1;
                    JSRuntime.InvokeVoidAsync("changeSegment", IDs[i], i2, bit);
                    segments >>= 1;
                }
            }
        }
        else
        {
            for (int i = 0; i < values.Length; i++)
            {
                for (int i2 = 0; i2 < 8; i2++)
                {
                    uint bit = values[i] & 1;;
                    JSRuntime.InvokeVoidAsync("changeSegment", IDs[i], i2, bit);
                    values[i] >>= 1;
                }
            }
        }
    }

    void updateLEDs()
    {
        uint LEDValues = board.Parallel.Leds;
        for (int i = 0; i < 16; i++)
        {
            string ID = "led" + i;
            uint value = LEDValues & 1;
            JSRuntime.InvokeVoidAsync("changeLED", ID, value);
            LEDValues >>= 1;
        }
    }

    void updateSwitches()
    {
        uint switchValues = board.Parallel.Switches;
        for (int i = 0; i < 16; i++)
        {
            string ID = "switch" + i;
            uint value = switchValues & 1;
            JSRuntime.InvokeVoidAsync("changeSwitch", ID, value);
            switchValues >>= 1;
        }
    }

    private static List<string> GetExecutableInstructionLines(string source)
    {
        List<string> executableLines = new List<string>();
        string[] lines = source.Replace("\r", string.Empty).Split('\n');

        // Treat code as text by default so Blockly snippets without explicit .text are still parsed.
        bool inTextSegment = true;

        foreach (string rawLine in lines)
        {
            string line = rawLine;
            int commentIndex = line.IndexOf('#');
            if (commentIndex >= 0)
            {
                line = line[..commentIndex];
            }

            string trimmed = line.Trim();
            if (string.IsNullOrWhiteSpace(trimmed))
            {
                continue;
            }

            if (trimmed.StartsWith(".", StringComparison.Ordinal))
            {
                if (Regex.IsMatch(trimmed, @"^\.text\b", RegexOptions.IgnoreCase))
                {
                    inTextSegment = true;
                }
                else if (Regex.IsMatch(trimmed, @"^\.(data|bss)\b", RegexOptions.IgnoreCase))
                {
                    inTextSegment = false;
                }

                continue;
            }

            if (!inTextSegment)
            {
                continue;
            }

            int colonIndex = trimmed.IndexOf(':');
            if (colonIndex >= 0)
            {
                trimmed = trimmed[(colonIndex + 1)..].Trim();
                if (string.IsNullOrWhiteSpace(trimmed))
                {
                    continue;
                }
            }

            executableLines.Add(trimmed);
        }

        return executableLines;
    }

    private enum Segment
    {
        Text,
        Data,
        Bss
    }

    private static List<string> BuildMemoryLabels(string source)
    {
        Dictionary<Segment, List<string>> labelsBySegment = new Dictionary<Segment, List<string>>
        {
            [Segment.Text] = new List<string>(),
            [Segment.Data] = new List<string>(),
            [Segment.Bss] = new List<string>()
        };

        Segment currentSegment = Segment.Text;
        string? pendingLabel = null;

        string[] lines = source.Replace("\r", string.Empty).Split('\n');
        foreach (string rawLine in lines)
        {
            string line = rawLine;
            int commentIndex = line.IndexOf('#');
            if (commentIndex >= 0)
            {
                line = line[..commentIndex];
            }

            string trimmed = line.Trim();
            if (string.IsNullOrWhiteSpace(trimmed))
            {
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.text\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Text;
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.data\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Data;
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.bss\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Bss;
                continue;
            }

            Match labelMatch = Regex.Match(trimmed, @"^([a-zA-Z_][a-zA-Z0-9_.]*):\s*(.*)$");
            if (labelMatch.Success)
            {
                string label = labelMatch.Groups[1].Value;
                string remainder = labelMatch.Groups[2].Value.Trim();

                if (string.IsNullOrWhiteSpace(remainder))
                {
                    pendingLabel = label;
                    continue;
                }

                pendingLabel = label;
                trimmed = remainder;
            }

            int wordsProduced = GetWordsProducedForLine(trimmed, currentSegment);
            if (wordsProduced <= 0)
            {
                continue;
            }

            List<string> segmentLabels = labelsBySegment[currentSegment];
            for (int i = 0; i < wordsProduced; i++)
            {
                if (i == 0 && pendingLabel != null)
                {
                    segmentLabels.Add(pendingLabel);
                    pendingLabel = null;
                }
                else
                {
                    segmentLabels.Add(string.Empty);
                }
            }
        }

        return labelsBySegment[Segment.Text]
            .Concat(labelsBySegment[Segment.Data])
            .Concat(labelsBySegment[Segment.Bss])
            .ToList();
    }

    private static int GetWordsProducedForLine(string trimmedLine, Segment segment)
    {
        if (string.IsNullOrWhiteSpace(trimmedLine))
        {
            return 0;
        }

        if (trimmedLine.StartsWith(".global", StringComparison.OrdinalIgnoreCase)
            || trimmedLine.StartsWith(".equ", StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }

        if (segment == Segment.Text)
        {
            return trimmedLine.StartsWith(".", StringComparison.Ordinal) ? 0 : 1;
        }

        if (Regex.IsMatch(trimmedLine, @"^\.word\b", RegexOptions.IgnoreCase))
        {
            string operands = Regex.Replace(trimmedLine, @"^\.word\s+", string.Empty, RegexOptions.IgnoreCase);
            return operands.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
        }

        if (Regex.IsMatch(trimmedLine, @"^\.space\b", RegexOptions.IgnoreCase))
        {
            Match valueMatch = Regex.Match(trimmedLine, @"^\.space\s+([^\s,]+)", RegexOptions.IgnoreCase);
            if (!valueMatch.Success)
            {
                return 0;
            }

            if (TryParseAssemblyNumber(valueMatch.Groups[1].Value, out int spaceWords))
            {
                return Math.Max(spaceWords, 0);
            }

            return 0;
        }

        Match asciizMatch = Regex.Match(trimmedLine, @"^\.asciiz\s+""(.*)""$", RegexOptions.IgnoreCase);
        if (asciizMatch.Success)
        {
            return asciizMatch.Groups[1].Value.Length + 1;
        }

        Match asciiMatch = Regex.Match(trimmedLine, @"^\.ascii\s+""(.*)""$", RegexOptions.IgnoreCase);
        if (asciiMatch.Success)
        {
            return asciiMatch.Groups[1].Value.Length;
        }

        return trimmedLine.StartsWith(".", StringComparison.Ordinal) ? 0 : 1;
    }

    private static bool TryParseAssemblyNumber(string token, out int value)
    {
        value = 0;
        string cleaned = token.Trim();

        if (cleaned.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
        {
            return int.TryParse(cleaned[2..], NumberStyles.AllowHexSpecifier, CultureInfo.InvariantCulture, out value);
        }

        return int.TryParse(cleaned, NumberStyles.Integer, CultureInfo.InvariantCulture, out value);
    }

    private int? GetBlocklyBlockIndexForPc(uint programCounter)
    {
        if (blockIDs == null || blockIDs.Length == 0)
        {
            return null;
        }

        int relativePc = (int)programCounter - blocklyInstructionStartPc;
        if (relativePc < 0)
        {
            return null;
        }

        if (relativePc >= blocklyInstructionCount)
        {
            return null;
        }

        if (relativePc >= blockIDs.Length)
        {
            return null;
        }

        return relativePc;
    }

