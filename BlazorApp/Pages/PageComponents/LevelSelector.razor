@inject IJSRuntime JSRuntime
@inject ChecklistStateStore ChecklistState
@implements IDisposable

<div class="col-auto" @ref="levelSelectRef">
    <button class="btn btn-primary my-2" type="button" data-bs-toggle="collapse" data-bs-target="#levelSelect" aria-expanded="true" aria-controls="levelSelect">
        ☰
    </button>
    <div class="collapse collapse-horizontal show" id="levelSelect">
        <ul class="nav flex-column nav-pills">
            @* Sandbox - Home Page - position in list as needed *@
            <LevelNavItem href="." name="Sandbox" Steps="@NoSteps" />

            @* Example levels *@
            <LevelNavItem href="levelIntro" name="Introduction" Steps="@NoSteps" />
            <LevelNavItem href="levelOne" name="#1" Steps="@NoSteps" />
            <LevelNavItem href="levelTwo" name="#2" Steps="@NoSteps" />
            <LevelNavItem href="levelBranching" name="Branching" Steps="@NoSteps" />
            <LevelNavItem href="levelFour" name="Bitwise" Steps='@GetLevelSteps("levelFour")' LevelId="levelFour" SelectedStepIndex='@GetSelectedStepIndex("levelFour")' />

            <button class="btn btn-danger float-end my-2 ms-4" @onclick="ResetLevels" data-bs-toggle="modal" data-bs-target="#deleteModal" @ref="resetLevelButtonRef"> 
                Reset Level Progress
            </button>
        </ul>
    </div>
</div>

@code {
    private static readonly IReadOnlyList<ChecklistStep> NoSteps = [];
    private ElementReference levelSelectRef;
    private ElementReference resetLevelButtonRef;
    [Inject]
    private SpotlightRegistry SpotlightRegistry { get; set; } = default!;


    protected override void OnInitialized()
    {
        ChecklistState.StateChanged += HandleChecklistStateChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            SpotlightRegistry.Register("levelSelect", levelSelectRef);
            SpotlightRegistry.Register("resetLevelButton", resetLevelButtonRef);
            await JSRuntime.InvokeVoidAsync("levelSelect");
            await JSRuntime.InvokeVoidAsync("levelCheck");
            await JSRuntime.InvokeVoidAsync("clearPopovers");
        }
    }

    private IReadOnlyList<ChecklistStep> GetLevelSteps(string levelId)
    {
        if (ChecklistState.TryGetSteps(levelId, out IReadOnlyList<ChecklistStep>? steps))
        {
            return steps;
        }

        return NoSteps;
    }

    private int GetSelectedStepIndex(string levelId)
    {
        if (ChecklistState.TryGetSelectedStepIndex(levelId, out int selectedStepIndex))
        {
            return selectedStepIndex;
        }

        return -1;
    }

    private void HandleChecklistStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChecklistState.StateChanged -= HandleChecklistStateChanged;
    }

    public void ResetLevels()
    {
        _ = JSRuntime.InvokeVoidAsync("resetLevels");
        ChecklistState.ResetToDefaults();
    }
}

<style>
.checklist-dropdown {
    padding: 0.5rem 0;
    background-color: rgba(0, 0, 0, 0.05);
}

.checklist {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
}

.checklist-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem;
    border-radius: 0.25rem;
    transition: background-color 0.2s;
}

.checklist-item-button {
    width: 100%;
    border: 0;
    text-align: left;
    background: transparent;
}

.checklist-item-button:hover {
    background-color: rgba(108, 117, 125, 0.18);
}

.checklist-item.incomplete {
    color: var(--bs-body-color);
}

.checklist-indicator {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: background-color 0.2s, border-color 0.2s;
}

.checklist-indicator.complete {
    background-color: #28a745;
    border: 2px solid #28a745;
}

.checklist-indicator.complete .checkmark {
    color: white;
    font-size: 12px;
    font-weight: bold;
    line-height: 1;
}

.checklist-indicator.started {
    background-color: #6c757d;
    border: 2px solid #6c757d;
}

.checklist-indicator.incomplete {
    background-color: transparent;
    border: 2px solid var(--bs-secondary);
    opacity: 0.6;
}

.checklist-item.selected {
    background-color: rgba(108, 117, 125, 0.22);
}

.checklist-label {
    font-size: 0.95rem;
}
</style>
