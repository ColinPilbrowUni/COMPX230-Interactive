@inject NavigationManager NavManager

<LevelLink href="@href" name="@name" />

@if (IsSelectedLevel() && Steps.Count > 0)
{
    <LevelChecklistDropdown Steps="@Steps" LevelId="@LevelId" SelectedStepIndex="@SelectedStepIndex" />
}

@code {
    [Parameter]
    required public string href { get; set; }

    [Parameter]
    required public string name { get; set; }

    [Parameter]
    public IReadOnlyList<ChecklistStep> Steps { get; set; } = [];

    [Parameter]
    public string LevelId { get; set; } = string.Empty;

    [Parameter]
    public int SelectedStepIndex { get; set; } = -1;

    private bool IsSelectedLevel()
    {
        var uri = new Uri(NavManager.Uri);
        var currentPath = uri.AbsolutePath.Split('/').Last();

        if (href == ".")
        {
            return string.IsNullOrEmpty(currentPath);
        }

        return string.Equals(currentPath, href, StringComparison.OrdinalIgnoreCase);
    }
}