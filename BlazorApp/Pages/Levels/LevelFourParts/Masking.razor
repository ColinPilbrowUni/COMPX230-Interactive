@using RexSimulator.Hardware

<section>
    <h2>Masking</h2>
    <h3>Understanding Bitwise Masking</h3>
    <p>Masking is a technique used to isolate or clear specific bits in a value. A mask is a binary pattern used with logical operations like AND, OR, and XOR.</p>

    <h4>Question One</h4>
    <p>If you want to keep only the lower 8 bits of a 32-bit value and clear all other bits, what hexadecimal mask would you use with an AND operation?</p>
    <input id="inputMaskOne" @oninput="OnInputMaskOneChanged" placeholder="e.g. 0x0F" />
    <label class="inputCheckmark" id="inputMaskOneCheckmark" for="inputMaskOne"><i class="bi bi-check-lg"></i></label>

    @if (Section >= 1)
    {
        <h4>Question Two</h4>
        <p>Which bitwise operation toggles specific bits (setting 0s to 1s and 1s to 0s at the masked positions)?</p>
        <input id="inputMaskTwo" @oninput="OnInputMaskTwoChanged" placeholder="e.g. AND" />
        <label class="inputCheckmark" id="inputMaskTwoCheckmark" for="inputMaskTwo"><i class="bi bi-check-lg"></i></label>
    }

    @if (Section >= 2)
    {
        <h3>Question Three <label class="inputCheckmark" id="checkmarkThree"><i class="bi bi-check-lg"></i></label></h3>
        <p><b>Turn on all switches</b>, then load the switch value into register <code>$1</code> and mask it with 0xFF into <code>$2</code>.</p>
        <p>Tip: Use an AND immediate instruction to apply the mask to <code>$1</code> and store the result in <code>$2</code>.</p>
        <p>Expected with all switches on: <code>$2 = 255</code>.</p>
    }

    @if (Section >= 3)
    {
        <h3>Question Four <label class="inputCheckmark" id="checkmarkFour"><i class="bi bi-check-lg"></i></label></h3>
        <p>Mask the value in $1 to keep only bits 4-7 and clear all other bits. Store the result in $3.</p>
        <p>Tip: The mask for bits 4-7 is 0xF0 (1111 0000 in binary).</p>
    }

    @if (Section >= 4)
    {
        <p>Excellent! You've mastered bitwise masking.</p>
        <button class="btn btn-primary" @onclick="NextSection">Next Section</button>
    }
</section>

@code {
    public static readonly LevelGroupPart GroupPart = new("masking", "Masking", ProgressScopeId);

    public const string ProgressScopeId = "levelFourMasking";
    public const string BlocklyStorageKey = "levelFourMaskingBlockly";

    public static UIComponents Components { get; } = new(
        Blockly: true,
        Code: true,
        Switches: true,
        LEDs: true,
        GPRegisters: true,
        ParallelRegisters: true,
        Visualiser: true);

    public static Toolbox Toolbox { get; } = new()
    {
        contents = new List<Category>() {
            new Category {
                name = "Sections",
                categorystyle = "sectionCategory",
                contents = new List<Block>() {
                    new Block { type = "textHead" },
                    new Block { type = "global" }
                }
            },
            new Category {
                name = "Branch",
                categorystyle = "branchCategory",
                contents = new List<Block>() {
                    new Block { type = "label" },
                    new Block { type = "jumpRegister" },
                    new Block { type = "jump" }
                }
            },
            new Category {
                name = "Memory",
                categorystyle = "memoryCategory",
                contents = new List<Block>() {
                    new Block { type = "storeWord" },
                    new Block { type = "loadWord" }
                }
            },
            new Category {
                name = "Logic",
                categorystyle = "logicCategory",
                contents = new List<Block>() {
                    new Block { type = "bitwise" },
                    new Block { type = "bitwiseImmediate" },
                    new Block { type = "shift" },
                    new Block { type = "shiftImmediate" },
                }
            },
        }
    };

    public static string StartingWorkspace { get; } = """
    {"blocks":{"languageVersion":0,"blocks":[{"type":"textHead","id":"maskHead001","x":103,"y":56,"fields":{"instruction":".text"},"next":{"block":{"type":"global","id":"maskGlobal001","fields":{"instruction":".global main"},"next":{"block":{"type":"label","id":"maskMain001","fields":{"label":"main"},"next":{"block":{"type":"jumpRegister","id":"maskJr001","fields":{"instruction":"jr","register":"$ra"}}}}}}}}]}}
    """;

    public static string? MaxInstances { get; } = "{ 'textHead': 1}";

    public static string[][]? Library => null;

    private bool blocklyStepOneComplete;
    private bool blocklyStepTwoComplete;

    [Parameter]
    public int Section { get; set; }

    [Parameter]
    public EventCallback NextSection { get; set; }

    [Parameter]
    public Func<BoardCheck, bool>? VerifyBoard { get; set; }

    [Parameter]
    public RexBoard? Board { get; set; }

    [Parameter]
    public LevelComponents? LevelComponents { get; set; }

    [Parameter]
    public EventCallback<(int Section, bool StepOneComplete, bool StepTwoComplete, bool TriggerLevelCompleted)> ProgressChanged { get; set; }

    protected override void OnParametersSet()
    {
        blocklyStepOneComplete = Section >= 3 || blocklyStepOneComplete;
        blocklyStepTwoComplete = Section >= 4 || blocklyStepTwoComplete;
    }

    public void ApplyChecklistSelection(ChecklistStepStatus status, ref int section)
    {
        if (status == ChecklistStepStatus.Complete)
        {
            section = 4;
            blocklyStepOneComplete = true;
            blocklyStepTwoComplete = true;
            return;
        }

        if (blocklyStepTwoComplete)
        {
            section = 4;
        }
        else if (blocklyStepOneComplete)
        {
            section = 3;
        }
        else
        {
            // Question progression is tracked directly via Section (set by input handlers).
            section = Math.Clamp(Section, 0, 2);
        }
    }

    public Task HandleBoardChanged()
    {
        if (VerifyBoard == null || Board == null)
        {
            return Task.CompletedTask;
        }

        uint switchValue = Board.Parallel.Switches;

        // Check blockly tasks if we've passed the questions
        if (Section >= 2)
        {
            uint maskedValueBits47 = switchValue & 0xF0;

            bool allSwitchesOn = switchValue == 0xFFFF;
            bool regTwoIs255 = VerifyBoard(new BoardCheck(WRAMPComponents.GPRegisters, 255, 2));
            bool regThreeIsMaskedBits47 = VerifyBoard(new BoardCheck(WRAMPComponents.GPRegisters, maskedValueBits47, 3));

            bool maskingStepOneNow = allSwitchesOn && regTwoIs255;
            bool maskingStepTwoNow = (blocklyStepOneComplete || maskingStepOneNow) && regThreeIsMaskedBits47;

            blocklyStepOneComplete = blocklyStepOneComplete || maskingStepOneNow;
            blocklyStepTwoComplete = blocklyStepTwoComplete || maskingStepTwoNow;

            if (blocklyStepOneComplete && Section == 2)
            {
                Section = 3;
            }
            if (blocklyStepTwoComplete && Section == 3)
            {
                Section = 4;
            }
        }

        return ProgressChanged.InvokeAsync((Section, blocklyStepOneComplete, blocklyStepTwoComplete, false));
    }

    private async Task OnInputMaskOneChanged(ChangeEventArgs e)
    {
        string userInput = e.Value?.ToString() ?? "";
        string normalizedInput = userInput.Trim().ToUpperInvariant();

        if (normalizedInput == "0XFF" || normalizedInput == "FF" || normalizedInput == "255")
        {
            if (Section < 1)
            {
                Section = 1;
            }
            await JSRuntime.InvokeVoidAsync("objectiveCheck", "inputMaskOneCheckmark");
            await ProgressChanged.InvokeAsync((Section, blocklyStepOneComplete, blocklyStepTwoComplete, false));
        }
    }

    private async Task OnInputMaskTwoChanged(ChangeEventArgs e)
    {
        string userInput = e.Value?.ToString() ?? "";

        // Accept XOR in any case
        if (userInput.Trim().ToUpper() == "XOR")
        {
            if (Section < 2)
            {
                Section = 2;
            }
            await JSRuntime.InvokeVoidAsync("objectiveCheck", "inputMaskTwoCheckmark");
            await ProgressChanged.InvokeAsync((Section, blocklyStepOneComplete, blocklyStepTwoComplete, false));
        }
    }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = null!;
}
