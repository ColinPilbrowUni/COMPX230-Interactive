            {
                Section = 2;
            }

            await JSRuntime.InvokeVoidAsync("objectiveCheck", "inputBssQuestionTwoCheckmark");
            await ProgressChanged.InvokeAsync((Section, Section >= 4, false));
        }
    }

    private static List<BssSpaceDeclaration> ParseBssSpaceDeclarations(string source)
    {
        List<BssSpaceDeclaration> declarations = new List<BssSpaceDeclaration>();
        if (string.IsNullOrWhiteSpace(source))
        {
            return declarations;
        }

        Segment currentSegment = Segment.Text;
        string? pendingLabel = null;
        string[] lines = source.Replace("\r", string.Empty).Split('\n');

        foreach (string rawLine in lines)
        {
            string line = StripComments(rawLine);
            string trimmed = line.Trim();
            if (string.IsNullOrWhiteSpace(trimmed))
            {
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.text\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Text;
                pendingLabel = null;
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.data\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Data;
                pendingLabel = null;
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.bss\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Bss;
                pendingLabel = null;
                continue;
            }

            Match labelMatch = Regex.Match(trimmed, @"^([a-zA-Z_][a-zA-Z0-9_.]*):\s*(.*)$");
            if (labelMatch.Success)
            {
                pendingLabel = labelMatch.Groups[1].Value;
                trimmed = labelMatch.Groups[2].Value.Trim();

                if (string.IsNullOrWhiteSpace(trimmed))
                {
                    continue;
                }
            }

            if (currentSegment != Segment.Bss)
            {
                pendingLabel = null;
                continue;
            }

            Match spaceMatch = Regex.Match(trimmed, @"^\.space\s+([^\s,]+)", RegexOptions.IgnoreCase);
            if (!spaceMatch.Success)
            {
                pendingLabel = null;
                continue;
            }

            if (pendingLabel == null)
            {
                continue;
            }

            if (!TryParseAssemblyNumber(spaceMatch.Groups[1].Value, out int spaceLength) || spaceLength <= 0)
            {
                continue;
            }

            declarations.Add(new BssSpaceDeclaration(pendingLabel, spaceLength));
            pendingLabel = null;
        }

        return declarations;
    }

    private bool HasOrderedMessageInDeclaredBssBuffer(RexBoard board, string source, List<BssSpaceDeclaration> declarations)
    {
        if (declarations.Count == 0)
        {
            return false;
        }

        Dictionary<string, int> labelAddresses = BuildLabelAddresses(source);
        foreach (BssSpaceDeclaration declaration in declarations)
        {
            if (declaration.SpaceLength < ExpectedOrderedMessageWords.Length)
            {
                continue;
            }

            if (!labelAddresses.TryGetValue(declaration.Label, out int startAddress))
            {
                continue;
            }

            if (startAddress < 0 || startAddress + ExpectedOrderedMessageWords.Length > board.RAM.mMemory.Length)
            {
                continue;
            }

            JSRuntime.InvokeVoidAsync("console.log", $"Checking .bss label '{declaration.Label}' at address {startAddress:X8} for ordered message.");

            bool matches = true;
            for (int i = 0; i < ExpectedOrderedMessageWords.Length; i++)
            {
                if (board.RAM.mMemory[startAddress + i] != ExpectedOrderedMessageWords[i])
                {
                    matches = false;
                    break;
                }
            }

            if (matches)
            {
                return true;
            }
        }

        return false;
    }

    private static string BuildAnalyzableSource(string userCode)
    {
        if (string.IsNullOrWhiteSpace(userCode))
        {
            return string.Empty;
        }

        string source = userCode;

        // GetUserCode() can return only the Blockly region; append fixed library segments
        // so label addresses line up with the same assembled memory layout shown in RAM.
        if (!source.Contains("main:", StringComparison.Ordinal))
        {
            source = string.Concat(Library?[0][1] ?? string.Empty, "\n", source);
        }

        if (!source.Contains("message:", StringComparison.Ordinal))
        {
            source = string.Concat(source, "\n", Library?[2][1] ?? string.Empty);
        }

        return source;
    }

    private static Dictionary<string, int> BuildLabelAddresses(string source)
    {
        Dictionary<string, int> labelAddresses = new Dictionary<string, int>(StringComparer.Ordinal);
        Dictionary<string, SegmentedLabelAddress> segmentedLabelAddresses = new Dictionary<string, SegmentedLabelAddress>(StringComparer.Ordinal);
        if (string.IsNullOrWhiteSpace(source))
        {
            return labelAddresses;
        }

        int textWords = 0;
        int dataWords = 0;
        int bssWords = 0;

        Segment currentSegment = Segment.Text;
        string? pendingLabel = null;
        string[] lines = source.Replace("\r", string.Empty).Split('\n');

        foreach (string rawLine in lines)
        {
            string line = StripComments(rawLine);
            string trimmed = line.Trim();
            if (string.IsNullOrWhiteSpace(trimmed))
            {
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.text\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Text;
                pendingLabel = null;
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.data\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Data;
                pendingLabel = null;
                continue;
            }

            if (Regex.IsMatch(trimmed, @"^\.bss\b", RegexOptions.IgnoreCase))
            {
                currentSegment = Segment.Bss;
                pendingLabel = null;
                continue;
            }

            Match labelMatch = Regex.Match(trimmed, @"^([a-zA-Z_][a-zA-Z0-9_.]*):\s*(.*)$");
            if (labelMatch.Success)
            {
                pendingLabel = labelMatch.Groups[1].Value;
                trimmed = labelMatch.Groups[2].Value.Trim();

                if (string.IsNullOrWhiteSpace(trimmed))
                {
                    continue;
                }
            }

            int wordsProduced = GetWordsProducedForLine(trimmed, currentSegment);
            if (wordsProduced <= 0)
            {
                continue;
            }

            if (pendingLabel != null && !segmentedLabelAddresses.ContainsKey(pendingLabel))
            {
                int segmentOffset = currentSegment switch
                {
                    Segment.Text => textWords,
                    Segment.Data => dataWords,
                    _ => bssWords
                };

                segmentedLabelAddresses[pendingLabel] = new SegmentedLabelAddress(currentSegment, segmentOffset);
            }

            switch (currentSegment)
            {
                case Segment.Text:
                    textWords += wordsProduced;
                    break;
                case Segment.Data:
                    dataWords += wordsProduced;
                    break;
                case Segment.Bss:
                    bssWords += wordsProduced;
                    break;
            }

            pendingLabel = null;
        }

        foreach ((string label, SegmentedLabelAddress segmentedAddress) in segmentedLabelAddresses)
        {
            labelAddresses[label] = segmentedAddress.ToAbsoluteAddress(textWords, dataWords);
        }

        return labelAddresses;
    }

    private static int GetWordsProducedForLine(string trimmedLine, Segment segment)
    {
        if (string.IsNullOrWhiteSpace(trimmedLine))
        {
            return 0;
        }

        if (trimmedLine.StartsWith(".global", StringComparison.OrdinalIgnoreCase)
            || trimmedLine.StartsWith(".equ", StringComparison.OrdinalIgnoreCase))
        {
            return 0;
        }

        if (segment == Segment.Text)
        {
            return trimmedLine.StartsWith(".", StringComparison.Ordinal) ? 0 : 1;
        }

        if (Regex.IsMatch(trimmedLine, @"^\.word\b", RegexOptions.IgnoreCase))
        {
            string operands = Regex.Replace(trimmedLine, @"^\.word\s+", string.Empty, RegexOptions.IgnoreCase);
            return operands.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
        }

        if (Regex.IsMatch(trimmedLine, @"^\.space\b", RegexOptions.IgnoreCase))
        {
            Match valueMatch = Regex.Match(trimmedLine, @"^\.space\s+([^\s,]+)", RegexOptions.IgnoreCase);
            if (!valueMatch.Success)
            {
                return 0;
            }

            if (TryParseAssemblyNumber(valueMatch.Groups[1].Value, out int spaceWords))
            {
                return Math.Max(spaceWords, 0);
            }

            return 0;
        }

        Match asciizMatch = Regex.Match(trimmedLine, @"^\.asciiz\s+""(.*)""$", RegexOptions.IgnoreCase);
        if (asciizMatch.Success)
        {
            return asciizMatch.Groups[1].Value.Length + 1;
        }

        Match asciiMatch = Regex.Match(trimmedLine, @"^\.ascii\s+""(.*)""$", RegexOptions.IgnoreCase);
        if (asciiMatch.Success)
        {
            return asciiMatch.Groups[1].Value.Length;
        }

        return trimmedLine.StartsWith(".", StringComparison.Ordinal) ? 0 : 1;
    }

    private static bool TryParseAssemblyNumber(string token, out int value)
    {
        value = 0;
        string cleaned = token.Trim();

        if (cleaned.StartsWith("0x", StringComparison.OrdinalIgnoreCase))
        {
            return int.TryParse(cleaned[2..], NumberStyles.AllowHexSpecifier, CultureInfo.InvariantCulture, out value);
        }

        return int.TryParse(cleaned, NumberStyles.Integer, CultureInfo.InvariantCulture, out value);
    }

    private static string StripComments(string line)
    {
        int commentIndex = line.IndexOf('#');
        return commentIndex >= 0 ? line[..commentIndex] : line;
    }

    private enum Segment
    {
        Text,
        Data,
        Bss
    }

    private sealed record SegmentedLabelAddress(Segment Segment, int SegmentOffset)
    {
        public int ToAbsoluteAddress(int textWords, int dataWords)
        {
            return Segment switch
            {
                Segment.Text => SegmentOffset,
                Segment.Data => textWords + SegmentOffset,
                _ => textWords + dataWords + SegmentOffset
            };
        }
    }

    private sealed record BssSpaceDeclaration(string Label, int SpaceLength);
	}

