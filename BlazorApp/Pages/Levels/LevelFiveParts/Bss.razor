@using RexSimulator.Hardware
@inject IJSRuntime JSRuntime

<section>
    <h2>.bss</h2>
    <h3>Using Uninitialized Memory</h3>

    <h4>Question One</h4>
    <p>What WRAMP directive allocates 7 rows of uninitialized memory under <code>.bss</code>?</p>
    <input id="inputBssQuestionOne" @oninput="OnInputBssQuestionOneChanged" placeholder="Type your answer here" />
    <label class="inputCheckmark" id="inputBssQuestionOneCheckmark" for="inputBssQuestionOne"><i class="bi bi-check-lg"></i></label>

    @if (Section >= 1)
    {
        <h4>Question Two</h4>
        <p>True or false? Labelled blocks of uninitialized memory in <code>.bss</code> are separated by an <b>additional</b> row in memory with value <code>0</code>.</p>
        <select id="inputBssQuestionTwo" @onchange="OnInputBssQuestionTwoChanged">
            <option value="">Select an answer</option>
            <option value="True">True</option>
            <option value="False">False</option>
        </select>
        <label class="inputCheckmark" id="inputBssQuestionTwoCheckmark" for="inputBssQuestionTwo"><i class="bi bi-check-lg"></i></label>
    }

	<h4 class="mt-3" hidden="@(Section < 2)">Reversed Message</h4>

    <ul>
        <li hidden="@(Section < 2)">The current message in <code>.data</code> is reversed.</li>
        <li hidden="@(Section < 2)">Create a <code>.bss</code> section with a label and reserve space using <code>.space 17</code>.</li>
        <li hidden="@(Section < 2)">The 17 words include every character plus the <code>0</code> delimiter.</li>
        <label class="inputCheckmark" id="bssStepOneCheckmark" hidden="@(Section < 2)"><i class="bi bi-check-lg"></i></label>

        <li hidden="@(Section < 3)">Now copy the message into your <code>.bss</code> buffer in the correct order.</li>
        <li hidden="@(Section < 3)">Step 2 completes when memory under your chosen <code>.bss</code> label contains the full ordered message and delimiter.</li>
        <label class="inputCheckmark" id="bssStepTwoCheckmark" hidden="@(Section < 3)"><i class="bi bi-check-lg"></i></label>

        <li hidden="@(Section < 4)">Bonus task: write the correctly ordered message to the serial port.</li>
        <label class="inputCheckmark" id="bssStepThreeCheckmark" hidden="@(Section < 4)"><i class="bi bi-check-lg"></i></label>

        <li hidden="@(Section < 5)">Bonus complete. Serial output now shows the ordered message.</li>
    </ul>
</section>

