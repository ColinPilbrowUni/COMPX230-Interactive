	[Parameter]
	public int Section { get; set; }

    [Parameter]
    public RexBoard? Board { get; set; }

    [Parameter]
    public LevelComponents? LevelComponents { get; set; }

	[Parameter]
	public EventCallback<(int Section, bool StepComplete, bool TriggerLevelCompleted)> ProgressChanged { get; set; }

    protected override void OnParametersSet()
	{
        if (Section >= 1)
        {
            _ = JSRuntime.InvokeVoidAsync("objectiveCheck", "inputBssQuestionOneCheckmark");
        }

        if (Section >= 2)
        {
            _ = JSRuntime.InvokeVoidAsync("objectiveCheck", "inputBssQuestionTwoCheckmark");
        }

        if (Section >= 3)
        {
            _ = JSRuntime.InvokeVoidAsync("objectiveCheck", "bssStepOneCheckmark");
        }

        if (Section >= 4)
        {
            _ = JSRuntime.InvokeVoidAsync("objectiveCheck", "bssStepTwoCheckmark");
        }

        if (Section >= 5)
        {
            _ = JSRuntime.InvokeVoidAsync("objectiveCheck", "bssStepThreeCheckmark");
        }
    }

    public async Task HandleBoardChanged()
    {
        if (Board == null || LevelComponents == null)
        {
            return;
        }

        string userCode = await LevelComponents.GetUserCode();
        string analyzableSource = BuildAnalyzableSource(userCode);
        List<BssSpaceDeclaration> bssDeclarations = ParseBssSpaceDeclarations(analyzableSource);

        bool stepOneComplete = Section >= 3;
        bool stepTwoComplete = Section >= 4;
        bool stepThreeComplete = false;
        bool triggerLevelCompleted = false;

        if (Section >= 2)
        {
            bool stepOneCompleteNow = bssDeclarations.Any(d => d.SpaceLength == RequiredBssSpaceLength);
            if (stepOneCompleteNow)
            {
                stepOneComplete = true;
                await JSRuntime.InvokeVoidAsync("objectiveCheck", "bssStepOneCheckmark");
                if (Section < 3)
                {
                    Section = 3;
                }

                bool stepTwoCompleteNow = HasOrderedMessageInDeclaredBssBuffer(Board, analyzableSource, bssDeclarations);
                if (stepTwoCompleteNow)
                {
                    stepTwoComplete = true;
                    await JSRuntime.InvokeVoidAsync("objectiveCheck", "bssStepTwoCheckmark");
                    if (Section < 4)
                    {
                        Section = 4;
                        triggerLevelCompleted = true;
                    }
                }
            }
        }

        if (Section >= 4)
        {
            stepThreeComplete = string.Equals(Board.Serial1.serialText, ExpectedOrderedMessageText, StringComparison.Ordinal);
            if (stepThreeComplete)
            {
                await JSRuntime.InvokeVoidAsync("objectiveCheck", "bssStepThreeCheckmark");
                if (Section < 5)
                {
                    Section = 5;
                }
            }
        }

        await ProgressChanged.InvokeAsync((Section, stepTwoComplete, triggerLevelCompleted));
    }

    private async Task OnInputBssQuestionOneChanged(ChangeEventArgs e)
    {
        string userInput = e.Value?.ToString() ?? string.Empty;
        string normalizedInput = Regex.Replace(userInput.Trim().ToLowerInvariant(), @"\s+", " ");

        if (normalizedInput == ".space 7")
        {
            if (Section < 1)
            {
                Section = 1;
            }

            await JSRuntime.InvokeVoidAsync("objectiveCheck", "inputBssQuestionOneCheckmark");
            await ProgressChanged.InvokeAsync((Section, Section >= 4, false));
        }
    }

    private async Task OnInputBssQuestionTwoChanged(ChangeEventArgs e)
    {
        string selectedValue = e.Value?.ToString() ?? string.Empty;

        if (string.Equals(selectedValue, "False", StringComparison.OrdinalIgnoreCase))
        {
