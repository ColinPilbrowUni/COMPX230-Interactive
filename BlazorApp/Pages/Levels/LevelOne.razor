@page "/levelOne"
@using RexSimulator.Hardware
@using BlazorApp.Pages.Levels.LevelOneParts
@inject IJSRuntime JSRuntime
@inject ChecklistStateStore ChecklistState
@implements IDisposable

<Level @ref="levelComponent" Title="Introduction" BoardChanged="HandleBoardChanged" UIComponents="@CurrentComponents" Toolbox="@CurrentToolbox" WSIMInstructions="@CurrentWSIMInstructions" MainInstructions="@CurrentMainInstructions" startingWorkspace="@CurrentStartingWorkspace" maxInstances="@CurrentMaxInstances" Library="@CurrentLibrary" />

@code {
    public Level? levelComponent;
    public LevelComponents lc = new();
    public WSIM? WSIM;
    public RexBoard? board;

    private QuickTour? quickTourPartRef;
    private Welcome? welcomePartRef;
    private HelloWorld? helloWorldPartRef;
    private LevelGroupGateway gateway = default!;

    private UIComponents CurrentComponents => gateway.CurrentPartIndex switch
    {
        0 => QuickTour.Components,
        1 => Welcome.Components,
        _ => HelloWorld.Components
    };

    private Toolbox CurrentToolbox => gateway.CurrentPartIndex switch
    {
        0 => QuickTour.Toolbox,
        1 => Welcome.Toolbox,
        _ => HelloWorld.Toolbox
    };

    private string CurrentStartingWorkspace => gateway.CurrentPartIndex switch
    {
        0 => QuickTour.StartingWorkspace,
        1 => Welcome.StartingWorkspace,
        _ => HelloWorld.StartingWorkspace
    };

    private string? CurrentMaxInstances => gateway.CurrentPartIndex switch
    {
        0 => QuickTour.MaxInstances,
        1 => Welcome.MaxInstances,
        _ => HelloWorld.MaxInstances
    };

    private string[][]? CurrentLibrary => gateway.CurrentPartIndex switch
    {
        0 => QuickTour.Library,
        1 => Welcome.Library,
        _ => HelloWorld.Library
    };

    private RenderFragment? CurrentWSIMInstructions => gateway.CurrentPartIndex switch
    {
        2 => null,
        _ => Instructions
    };

    private RenderFragment? CurrentMainInstructions => gateway.CurrentPartIndex switch
    {
        2 => Instructions,
        _ => null
    };

    protected override void OnInitialized()
    {
        gateway = new LevelGroupGateway("levelOne", new[] { QuickTour.GroupPart, Welcome.GroupPart, HelloWorld.GroupPart });
        ChecklistState.SectionSelectionRequested += HandleSectionSelectionRequested;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (levelComponent != null && levelComponent.wsimComponent != null)
        {
            board = levelComponent.wsimComponent.board;
            WSIM = levelComponent.wsimComponent;
        }

        lc.SetJSRuntime(JSRuntime);
        await gateway.InitializeAsync(JSRuntime, ChecklistState);
        await SyncChecklistStateFromStoredProgress();
        await ApplyCurrentPartConfig();
        await HandleBoardChanged();
        StateHasChanged();
    }

    private async Task SyncChecklistStateFromStoredProgress()
    {
        int quickTourSection = await JSRuntime.InvokeAsync<int>("getScopedProgress", QuickTour.ProgressScopeId, "Section");
        int welcomeSection = await JSRuntime.InvokeAsync<int>("getScopedProgress", Welcome.ProgressScopeId, "Section");
        int helloWorldSection = await JSRuntime.InvokeAsync<int>("getScopedProgress", HelloWorld.ProgressScopeId, "Section");

        ChecklistStepStatus quickTourStatus = quickTourSection >= 3
            ? ChecklistStepStatus.Complete
            : ChecklistStepStatus.Started;

        bool welcomeUnlockedOrVisited = welcomeSection > 0 || quickTourSection >= 3 || gateway.CurrentPartIndex >= 1;
        ChecklistStepStatus welcomeStatus = welcomeSection >= 6
            ? ChecklistStepStatus.Complete
            : (welcomeUnlockedOrVisited ? ChecklistStepStatus.Started : ChecklistStepStatus.Incomplete);

        bool helloWorldUnlockedOrVisited = helloWorldSection > 0 || welcomeSection >= 6 || gateway.CurrentPartIndex >= 2;
        ChecklistStepStatus helloWorldStatus = helloWorldSection >= 2
            ? ChecklistStepStatus.Complete
            : (helloWorldUnlockedOrVisited ? ChecklistStepStatus.Started : ChecklistStepStatus.Incomplete);

        gateway.SetPartStatusWithoutDowngrade(ChecklistState, 0, quickTourStatus);
        gateway.SetPartStatusWithoutDowngrade(ChecklistState, 1, welcomeStatus);
        gateway.SetPartStatusWithoutDowngrade(ChecklistState, 2, helloWorldStatus);
    }

    private void HandleSectionSelectionRequested(string levelId, int stepIndex, ChecklistStepStatus status)
    {
        if (!string.Equals(levelId, gateway.LevelId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await ApplyChecklistSectionSelection(stepIndex, status);
        });
    }

    private async Task ApplyChecklistSectionSelection(int stepIndex, ChecklistStepStatus status)
    {
        if (!gateway.IsValidIndex(stepIndex))
        {
            return;
        }

        await gateway.SelectPartAsync(stepIndex, JSRuntime, ChecklistState);
        await ApplyCurrentPartConfig();

        lc.Section = GetSectionFromChecklistSelection(status);

        StateHasChanged();
        await Task.Yield();
        await HandleBoardChanged();
        StateHasChanged();
    }

    private int GetSectionFromChecklistSelection(ChecklistStepStatus status)
    {
        if (status == ChecklistStepStatus.Complete)
        {
            return gateway.CurrentPartIndex switch
            {
                0 => 3,
                1 => 6,
                _ => 2
            };
        }

        return gateway.CurrentPartIndex switch
        {
            0 => Math.Clamp(lc.Section, 0, 2),
            1 => Math.Clamp(lc.Section, 0, 5),
            _ => Math.Clamp(lc.Section, 0, 1)
        };
    }

    private async Task ApplyCurrentPartConfig()
    {
        if (gateway.CurrentPartIndex == 0)
        {
            lc.SetProgressScope(QuickTour.ProgressScopeId);
            await lc.getProgress();
            if (QuickTour.Components.Blockly)
            {
                await lc.UpdateToolbox(QuickTour.Toolbox);
                await JSRuntime.InvokeVoidAsync("loadSavedOrPresetWorkspace", QuickTour.BlocklyStorageKey, QuickTour.StartingWorkspace);
            }
        }
        else if (gateway.CurrentPartIndex == 1)
        {
            lc.SetProgressScope(Welcome.ProgressScopeId);
            await lc.getProgress();
            if (Welcome.Components.Blockly)
            {
                await lc.UpdateToolbox(Welcome.Toolbox);
                await JSRuntime.InvokeVoidAsync("loadSavedOrPresetWorkspace", Welcome.BlocklyStorageKey, Welcome.StartingWorkspace);
            }
        }
        else
        {
            lc.SetProgressScope(HelloWorld.ProgressScopeId);
            await lc.getProgress();
            if (HelloWorld.Components.Blockly)
            {
                await lc.UpdateToolbox(HelloWorld.Toolbox);
                await JSRuntime.InvokeVoidAsync("loadSavedOrPresetWorkspace", HelloWorld.BlocklyStorageKey, HelloWorld.StartingWorkspace);
            }
        }

        ChecklistState.SetSelectedStepIndex(gateway.LevelId, gateway.CurrentPartIndex);
        SyncChecklistState();
    }

    public async Task HandleBoardChanged()
    {
        if (levelComponent == null || levelComponent.wsimComponent == null)
        {
            return;
        }

        if (gateway.CurrentPartIndex == 0)
        {
            if (quickTourPartRef != null)
            {
                await quickTourPartRef.HandleBoardChanged();
            }
        }
        else if (gateway.CurrentPartIndex == 1)
        {
            if (welcomePartRef != null)
            {
                await welcomePartRef.HandleBoardChanged();
            }
        }
        else
        {
            if (helloWorldPartRef != null)
            {
                await helloWorldPartRef.HandleBoardChanged();
            }
        }
    }

    private Task HandlePartProgressChanged((int Section, bool StepComplete, bool TriggerLevelCompleted) progress)
    {
        lc.Section = progress.Section;

        if (progress.TriggerLevelCompleted)
        {
            lc.LevelCompleted();
        }

        SyncChecklistState();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void SyncChecklistState()
    {
        if (gateway.CurrentPartIndex == 0)
        {
            gateway.SetPartStatusWithoutDowngrade(ChecklistState, 0, lc.Section >= 3 ? ChecklistStepStatus.Complete : ChecklistStepStatus.Started);
            gateway.SetPartStatusWithoutDowngrade(ChecklistState, 1, ChecklistStepStatus.Incomplete);
            gateway.SetPartStatusWithoutDowngrade(ChecklistState, 2, ChecklistStepStatus.Incomplete);
            ChecklistState.SetSelectedStepIndex(gateway.LevelId, 0);
            return;
        }

        if (gateway.CurrentPartIndex == 1)
        {
            gateway.SetPartStatusWithoutDowngrade(ChecklistState, 0, ChecklistStepStatus.Complete);
            gateway.SetPartStatusWithoutDowngrade(ChecklistState, 1, lc.Section >= 6 ? ChecklistStepStatus.Complete : ChecklistStepStatus.Started);
            gateway.SetPartStatusWithoutDowngrade(ChecklistState, 2, ChecklistStepStatus.Incomplete);
            ChecklistState.SetSelectedStepIndex(gateway.LevelId, 1);
            return;
        }

        gateway.SetPartStatusWithoutDowngrade(ChecklistState, 0, ChecklistStepStatus.Complete);
        gateway.SetPartStatusWithoutDowngrade(ChecklistState, 1, ChecklistStepStatus.Complete);
        gateway.SetPartStatusWithoutDowngrade(ChecklistState, 2, lc.Section >= 2 ? ChecklistStepStatus.Complete : ChecklistStepStatus.Started);
        ChecklistState.SetSelectedStepIndex(gateway.LevelId, 2);
    }

    public async Task NextSection()
    {
        if (gateway.CurrentPartIndex == 0 && lc.Section >= 3)
        {
            await gateway.SelectPartAsync(1, JSRuntime, ChecklistState);
            lc.UncheckAllObjectives();
            await ApplyCurrentPartConfig();
            StateHasChanged();
            await Task.Yield();
            await HandleBoardChanged();
            StateHasChanged();
        }
        else if (gateway.CurrentPartIndex == 1 && lc.Section >= 6)
        {
            await gateway.SelectPartAsync(2, JSRuntime, ChecklistState);
            lc.UncheckAllObjectives();
            await ApplyCurrentPartConfig();
            StateHasChanged();
            await Task.Yield();
            await HandleBoardChanged();
            StateHasChanged();
        }
    }

    public RenderFragment Instructions =>
    @<div>
        @if (gateway.CurrentPartIndex == 0)
        {
            <QuickTour @ref="quickTourPartRef" Section="@lc.Section" NextSection="NextSection" WSIM="WSIM" LevelComponents="lc" ProgressChanged="HandlePartProgressChanged" />
        }
        else if (gateway.CurrentPartIndex == 1)
        {
            <Welcome @ref="welcomePartRef" Section="@lc.Section" NextSection="NextSection" WSIM="WSIM" Board="board" LevelComponents="lc" ProgressChanged="HandlePartProgressChanged" />
        }
        else
        {
            <HelloWorld @ref="helloWorldPartRef" Section="@lc.Section" ProgressChanged="HandlePartProgressChanged" />
        }
    </div>;

    public void Dispose()
    {
        ChecklistState.SectionSelectionRequested -= HandleSectionSelectionRequested;
    }
}