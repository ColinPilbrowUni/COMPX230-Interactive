@page "/levelFour"
@using RexSimulator.Hardware
@using System.Text.Json
@inject IJSRuntime JSRuntime

<Level @ref="levelComponent" Title="#4" BoardChanged="CheckBoard" UIComponents="@Components" Toolbox="@toolbox" WSIMInstructions="@Instructions" MainInstructions=null startingWorkspace="@startingWorkspace" maxInstances="@maxInstances" />

@code {
    public Level? levelComponent;
    public LevelComponents lc = new LevelComponents();
    required public WSIM WSIM;
    required public RexBoard board;
    public UIComponents Components = new UIComponents(Blockly: true, Code: true, SSDs: true, Switches: true, LEDs: true, GPRegisters: true, ParallelRegisters: true);
    public Toolbox toolbox = new Toolbox
    {
        contents = new List<Category>() {
            new Category {
                name = "Sections",
                categorystyle = "sectionCategory",
                contents = new List<Block>() {
                    new Block { type = "textHead" },
                    new Block { type = "global" }
                }
            },
            new Category {
                name = "Branch",
                categorystyle = "branchCategory",
                contents = new List<Block>() {
                    new Block { type = "label" },
                    new Block { type = "jumpRegister" },
                    new Block { type = "jump" }
                }
            },
            new Category {
                name = "Memory",
                categorystyle = "memoryCategory",
                contents = new List<Block>() {
                    new Block { type = "storeWord" },
                    new Block { type = "loadWord" }
                }
            },
            new Category {
                name = "Logic",
                categorystyle = "logicCategory",
                contents = new List<Block>() {
                    new Block { type = "bitwise" },
                    new Block { type = "bitwiseImmediate" },
                    new Block { type = "shift" },
                    new Block { type = "shiftImmediate" },
                }
            },
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (levelComponent != null && levelComponent.wsimComponent != null)
            {
                board = levelComponent.wsimComponent.board;
                WSIM = levelComponent.wsimComponent;
            }

            lc.SetJSRuntime(JSRuntime);
            await lc.getProgress();
            CheckBoard();
            StateHasChanged();
        }
    }

    public bool stepOne = false;
    public bool stepTwo = false;

    public void CheckBoard()
    {
        if (levelComponent == null || levelComponent.wsimComponent == null)
        {
            return;
        }

        uint switchValue = board.Parallel.Switches;
        bool regOneMatchesSwitches = WSIM.Verify(new BoardCheck(WRAMPComponents.GPRegisters, switchValue, 1));
        bool regTwoIsDoubleSwitches = WSIM.Verify(new BoardCheck(WRAMPComponents.GPRegisters, switchValue * 2, 2));

        // Require a non-zero switch setting so the objective does not auto-complete at reset state.
        stepOne = switchValue != 0 && regOneMatchesSwitches;
        stepTwo = switchValue != 0 && stepOne && regTwoIsDoubleSwitches;

        if (stepOne && lc.Section == 0)
        {
            lc.Section = 1;
        }
        if (stepTwo && lc.Section == 1)
        {
            lc.Section = 2;
            lc.LevelCompleted();
        }

        lc.CheckObjective(stepOne, "checkmarkOne");
        lc.CheckObjective(stepTwo, "checkmarkTwo");
        StateHasChanged();
    }

    public RenderFragment Instructions =>
    @<div>
        <section>
            <h2>Step One <label class="inputCheckmark" id="checkmarkOne"><i class="bi bi-check-lg"></i></label></h2>
            <p>First task: load the current switch value into register <code>$1</code>.</p>
            <p>Tip: Make sure at least one switch is on, then run or step your code and confirm <code>$1</code> updates.</p>

            @if (lc.Section >= 1)
            {
                <h2>Step Two <label class="inputCheckmark" id="checkmarkTwo"><i class="bi bi-check-lg"></i></label></h2>
                <p>Store double the switch value in register <code>$2</code> (after setting <code>$1</code>).</p>
                <p>Tip: Arithmetic insructions are not allowed in this level. Check for instructions in the "logic" category instead.</p>
            }

            @if (lc.Section >= 2)
            {
                <p>Nice work, both shifting tasks are complete.</p>
            }
        </section>
    </div>;

    public string maxInstances = "{ 'textHead': 1}";
    
    public string startingWorkspace = """
    {"blocks":{"languageVersion":0,"blocks":[{"type":"textHead","id":"3X;D%#OW7i/C5Y`#lxV=","x":103,"y":56,"fields":{"instruction":".text"},"next":{"block":{"type":"global","id":"Ob+QV2P-Bfx5]-[OBWs[","fields":{"instruction":".global main"},"next":{"block":{"type":"label","id":"5[{_!6Q9!c/j+g44.{5h","fields":{"label":"main"},"next":{"block":{"type":"jumpRegister","id":"3[hkavo[E!#|I|AnROCV","fields":{"instruction":"jr","register":"$ra"}}}}}}}}]}}
    """;
}
