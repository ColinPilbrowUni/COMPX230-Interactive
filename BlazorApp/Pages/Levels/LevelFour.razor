@page "/levelFour"
@using RexSimulator.Hardware
@using BlazorApp.Pages.Levels.LevelFourParts
@inject IJSRuntime JSRuntime
@inject ChecklistStateStore ChecklistState
@implements IDisposable

<Level @ref="levelComponent" Title="Bitwise" BoardChanged="CheckBoard" UIComponents="@CurrentComponents" Toolbox="@CurrentToolbox" WSIMInstructions="@Instructions" MainInstructions=null startingWorkspace="@CurrentStartingWorkspace" maxInstances="@CurrentMaxInstances" Library="@CurrentLibrary" />

@code {
    public Level? levelComponent;
    public LevelComponents lc = new();
    required public WSIM WSIM;
    required public RexBoard board;

    private readonly Shifting shiftingPart = new();
    private readonly Masking maskingPart = new();
    private LevelGroupGateway gateway = default!;
    private string maskingMessageGuess = string.Empty;

    private UIComponents CurrentComponents => gateway.CurrentPartIndex == 0 ? Shifting.Components : Masking.Components;
    private Toolbox CurrentToolbox => gateway.CurrentPartIndex == 0 ? Shifting.Toolbox : Masking.Toolbox;
    private string CurrentStartingWorkspace => gateway.CurrentPartIndex == 0 ? Shifting.StartingWorkspace : Masking.StartingWorkspace;
    private string? CurrentMaxInstances => gateway.CurrentPartIndex == 0 ? Shifting.MaxInstances : Masking.MaxInstances;
    private string[][]? CurrentLibrary => gateway.CurrentPartIndex == 0 ? Shifting.Library : Masking.Library;

    protected override void OnInitialized()
    {
        gateway = new LevelGroupGateway("levelFour", new[] { Shifting.GroupPart, Masking.GroupPart });
        ChecklistState.SectionSelectionRequested += HandleSectionSelectionRequested;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        if (levelComponent != null && levelComponent.wsimComponent != null)
        {
            board = levelComponent.wsimComponent.board;
            WSIM = levelComponent.wsimComponent;
        }

        lc.SetJSRuntime(JSRuntime);
        await MigrateLegacyProgressIfNeeded();
        await gateway.InitializeAsync(JSRuntime, ChecklistState);
        await ApplyCurrentPartConfig();
        await CheckBoard();
        StateHasChanged();
    }

    private async Task MigrateLegacyProgressIfNeeded()
    {
        int currentPartIndex = await JSRuntime.InvokeAsync<int>("getScopedProgress", gateway.LevelId, LevelGroupGateway.ActivePartProgressType);
        int shiftingSection = await JSRuntime.InvokeAsync<int>("getScopedProgress", Shifting.ProgressScopeId, "Section");
        int maskingSection = await JSRuntime.InvokeAsync<int>("getScopedProgress", Masking.ProgressScopeId, "Section");

        // If scoped progress already exists, do not overwrite it.
        if (currentPartIndex != 0 || shiftingSection != 0 || maskingSection != 0)
        {
            return;
        }

        int legacyPhase = await JSRuntime.InvokeAsync<int>("getLevelProgress", "levelFour", "Phase");
        int legacySection = await JSRuntime.InvokeAsync<int>("getLevelProgress", "levelFour", "Section");

        if (legacyPhase > 0)
        {
            await JSRuntime.InvokeVoidAsync("storeScopedProgress", gateway.LevelId, LevelGroupGateway.ActivePartProgressType, legacyPhase);
        }

        if (legacySection > 0)
        {
            string targetScope = legacyPhase == 1 ? Masking.ProgressScopeId : Shifting.ProgressScopeId;
            await JSRuntime.InvokeVoidAsync("storeScopedProgress", targetScope, "Section", legacySection);
        }
    }

    private void HandleSectionSelectionRequested(string levelId, int stepIndex, ChecklistStepStatus status)
    {
        if (!string.Equals(levelId, gateway.LevelId, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await ApplyChecklistSectionSelection(stepIndex, status);
        });
    }

    private async Task ApplyChecklistSectionSelection(int stepIndex, ChecklistStepStatus status)
    {
        if (!gateway.IsValidIndex(stepIndex))
        {
            return;
        }

        await gateway.SelectPartAsync(stepIndex, JSRuntime, ChecklistState);
        await ApplyCurrentPartConfig();

        int section = lc.Section;
        if (gateway.CurrentPartIndex == 0)
        {
            shiftingPart.ApplyChecklistSelection(status, ref section);
        }
        else
        {
            maskingPart.ApplyChecklistSelection(status, ref section);
        }
        lc.Section = section;

        await CheckBoard();
        StateHasChanged();
    }

    private async Task ApplyCurrentPartConfig()
    {
        if (gateway.CurrentPartIndex == 0)
        {
            lc.SetProgressScope(Shifting.ProgressScopeId);
            await lc.getProgress();
            shiftingPart.RestoreProgressFromSection(lc.Section);
            await lc.UpdateToolbox(Shifting.Toolbox);
            await JSRuntime.InvokeVoidAsync("loadSavedOrPresetWorkspace", Shifting.BlocklyStorageKey, Shifting.StartingWorkspace);
        }
        else
        {
            lc.SetProgressScope(Masking.ProgressScopeId);
            await lc.getProgress();
            maskingPart.RestoreProgressFromSection(lc.Section);
            await lc.UpdateToolbox(Masking.Toolbox);
            await JSRuntime.InvokeVoidAsync("loadSavedOrPresetWorkspace", Masking.BlocklyStorageKey, Masking.StartingWorkspace);
        }

        ChecklistState.SetSelectedStepIndex(gateway.LevelId, gateway.CurrentPartIndex);
        SyncChecklistState();
    }

    public async Task CheckBoard()
    {
        if (levelComponent == null || levelComponent.wsimComponent == null)
        {
            return;
        }

        (int section, bool stepOneComplete, bool stepTwoComplete, bool triggerLevelCompleted) result;
        if (gateway.CurrentPartIndex == 0)
        {
            result = await shiftingPart.CheckBoardAsync(
                WSIM.Verify,
                board,
                lc,
                lc.Section,
                maskingMessageGuess);
        }
        else
        {
            result = await maskingPart.CheckBoardAsync(
                WSIM.Verify,
                board,
                lc,
                lc.Section,
                maskingMessageGuess);
        }

        (int section, bool stepOneComplete, bool stepTwoComplete, bool triggerLevelCompleted) = result;

        lc.Section = section;

        if (triggerLevelCompleted)
        {
            lc.LevelCompleted();
        }

        SyncChecklistState();
        UpdateObjectiveCheckmarks(stepOneComplete, stepTwoComplete);
        StateHasChanged();
    }

    private void UpdateObjectiveCheckmarks(bool stepOneComplete, bool stepTwoComplete)
    {
        if (gateway.CurrentPartIndex == 0)
        {
            lc.CheckObjective(stepOneComplete, "checkmarkOne");
            lc.CheckObjective(stepTwoComplete, "checkmarkTwo");
            return;
        }

        lc.CheckObjective(stepOneComplete, "checkmarkThree");
        lc.CheckObjective(stepTwoComplete, "checkmarkFour");
    }

    private void SyncChecklistState()
    {
        if (gateway.CurrentPartIndex == 0)
        {
            gateway.SetPartStatusWithoutDowngrade(ChecklistState, 0, lc.Section >= 2 ? ChecklistStepStatus.Complete : ChecklistStepStatus.Started);
            gateway.SetPartStatusWithoutDowngrade(ChecklistState, 1, lc.Section >= 2 ? ChecklistStepStatus.Started : ChecklistStepStatus.Incomplete);
            ChecklistState.SetSelectedStepIndex(gateway.LevelId, 0);
            return;
        }

        gateway.SetPartStatusWithoutDowngrade(ChecklistState, 0, ChecklistStepStatus.Complete);
        gateway.SetPartStatusWithoutDowngrade(ChecklistState, 1, lc.Section >= 2 ? ChecklistStepStatus.Complete : ChecklistStepStatus.Started);
        ChecklistState.SetSelectedStepIndex(gateway.LevelId, 1);
    }

    public async Task NextSection()
    {
        if (gateway.CurrentPartIndex != 0 || lc.Section < 2)
        {
            return;
        }

        await gateway.SelectPartAsync(1, JSRuntime, ChecklistState);
        lc.UncheckAllObjectives();
        await ApplyCurrentPartConfig();
        await CheckBoard();
        StateHasChanged();
    }

    public async Task OnMaskingMessageChanged(ChangeEventArgs e)
    {
        maskingMessageGuess = e.Value?.ToString() ?? string.Empty;
        await CheckBoard();
    }

    public RenderFragment Instructions =>
    @<div>
        @if (gateway.CurrentPartIndex == 0)
        {
            <Shifting Section="@lc.Section" NextSection="NextSection" />
        }
        else
        {
            <Masking Section="@lc.Section" OnMaskingMessageChanged="OnMaskingMessageChanged" />
        }
    </div>;

    public void Dispose()
    {
        ChecklistState.SectionSelectionRequested -= HandleSectionSelectionRequested;
    }
}
